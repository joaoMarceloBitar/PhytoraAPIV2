# Porta do servidor HTTP
PORT=3080

# Interpretador Python usado para rodar o worker de inferência.
# No Windows, apontando para o venv do projeto:
#   PYTHON_CMD=./.venv/Scripts/python.exe
# No Linux/macOS:
#   PYTHON_CMD=./.venv/bin/python
# Se o venv já estiver ativado no shell, "python" basta.
PYTHON_CMD=python

# Caminho do checkpoint treinado (.pth).
# Padrão: <raiz do projeto>/models_saved/model.pth
# MODEL_PATH=
