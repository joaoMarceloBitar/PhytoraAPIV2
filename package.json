{
    "name": "phytora-api",
    "version": "2.0.0",
    "description": "API do Phytora — inferência de fitopatologias e monitoramento fitossanitário regional",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "prestart": "npm run build",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^4.18.3",
        "multer": "^1.4.5-lts.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.5.1",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    }
}
